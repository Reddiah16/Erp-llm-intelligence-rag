# Copy this file to .env (gitignored) and replace the placeholder values.
# Never put a real password in this file, in the README, or in a commit.

# ---- PostgreSQL (src/db/config.py) ----
# Required: POSTGRES_PASSWORD has no default; the app refuses to start a
# database connection without it. Defaults for the rest are shown.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erp_analytics
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# ---- Ollama (src/ai/settings.py) ----
# Chat model. The development default is qwen2.5:1.5b (fast, correct on the
# routing prompt); llama3.2 is NOT pulled in the intended local setup.
# Check what you actually have with:  ollama list
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_ROUTE_MODEL=qwen2.5:1.5b
OLLAMA_REQUEST_TIMEOUT=180

# ---- Embedding provider (src/ai/settings.py, src/rag/documents.py) ----
# "chroma" uses the bundled MiniLM model (downloaded once, on first use of the
# document corpus, into ~/.cache/chroma). "ollama" uses the server listed below
# and avoids the download entirely. No other provider is silently substituted.
RAG_EMBEDDING_PROVIDER=chroma
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- RAG behaviour (src/ai/settings.py) ----
RAG_TOP_K=4
AI_MAX_ROWS_IN_CONTEXT=15
AI_MAX_ANSWER_ROWS=15
AI_LIMIT_CEILING=50
AI_MAX_OUTPUT_TOKENS=400
AI_AVAILABILITY_TTL=60

# ---- Documents and ChromaDB (src/ai/settings.py, src/rag/documents.py) ----
# Relative paths are anchored to the repository root.
DOCUMENTS_DIR=documents
CHROMA_PATH=chroma_db
DOCUMENT_COLLECTION=erp_documents

# ---- MLflow metrics logging (src/evaluation/metrics.py) ----
# Optional: GET /query logs retrieval metrics here. Point at a running MLflow
# server or comment out if metrics logging is not needed.
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- Streamlit dashboard ----
# Where the dashboard finds the API. Defaults to http://localhost:8000 when
# unset.
# ERP_API_URL=http://localhost:8000
