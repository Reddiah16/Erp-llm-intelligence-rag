FROM python:3.10-slim
WORKDIR /app
COPY requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt
COPY src/ ./src/
COPY api/ ./api/
RUN mkdir -p ./chroma_db ./documents ./documents/uploads
# No --reload: a served API should not watch files and restart itself.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
